# Smart Municipal Waste Management Platform - Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT. NEVER COMMIT PRODUCTION SECRETS TO VERSION CONTROL.

NODE_ENV=development
PORT=3000

# Authentication & Cryptographic Tokens
# MUST be a secure random string of at least 32 characters in staging/production
JWT_SECRET=local_dev_placeholder_jwt_secret_min_32_characters_random_string!
JWT_EXPIRES_IN=8h

# PostgreSQL Connection & Role Configuration
# In PostgreSQL, RLS policies require a dedicated non-superuser role (waste_app_user).
# Migrations are executed by a separate non-superuser table owner (waste_migration_user).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waste_management_dev

# Dedicated Tripartite Roles (Pass placeholders for local dev)
DB_ADMIN_USER=waste_dba_admin
DB_ADMIN_PASSWORD=local_dba_password_placeholder
DB_MIGRATION_USER=waste_migration_user
DB_MIGRATION_PASSWORD=local_migration_password_placeholder
DB_APP_USER=waste_app_user
DB_APP_PASSWORD=local_app_password_placeholder

# Optional unified connection URL (for migration tools or standard local setups)
# DATABASE_URL=postgresql://waste_app_user:local_app_password_placeholder@localhost:5432/waste_management_dev

DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# ==============================================================================
# SIX OUTSTANDING POLICY CONFIGURATIONS (Awaiting formal municipal sign-off)
# ==============================================================================

# 1. GST Tax Policy: Unconfirmed pending municipal tax counsel review
TAX_POLICY_CONFIRMED=false
# Leave TAX_DEFAULT_RATE_BPS empty/unset for null (unconfirmed), or set e.g. 0 or 1800 if testing specific rates
TAX_DEFAULT_RATE_BPS=

# 2. Accounting Policy: Accrual vs cash timing and payment gateway fee treatment
ACCOUNTING_POLICY_CONFIRMED=false
REVENUE_RECOGNITION_TIMING=ACCRUAL_AT_BILLING
GATEWAY_FEE_TREATMENT=OPERATING_EXPENSE

# 3. Data Retention Schedules: Provisional engineering proposals
DATA_RETENTION_CONFIRMED=false
FINANCIAL_RETENTION_YEARS=7
CITIZEN_PII_RETENTION_YEARS=3
COMPLAINT_LOG_RETENTION_DAYS=180
TELEMETRY_RETENTION_DAYS=30

# 4. Property Identifier Strategy: PLATFORM_GENERATED | MUNICIPAL_PIN | BIDIRECTIONAL_MAPPING
PROPERTY_ID_STRATEGY=PLATFORM_GENERATED

# 5. Complaint Photos & Privacy Redaction Policy
COMPLAINT_PHOTOS_ALLOWED=true
COMPLAINT_PHOTOS_MANDATORY=false
COMPLAINT_PHOTO_BLURRING_MANDATORY=false

# 6. ERP Settlement Interface Boundary
ERP_SETTLEMENT_ENABLED=false
ERP_EXPORT_FORMAT=NONE
